<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- Package Metadata — aligned with https://github.com/johnsonmima/SaaFarr.AI.Prompt -->
    <PackageId>SaaFarr.AI.Prompt</PackageId>
    <Title>SaaFarr.AI.Prompt — Prompt Engineering Library</Title>
    <Description>
      A strongly typed, fluent prompt engineering library for .NET applications.
      Build, validate, and render prompts as first-class software assets.
      Supports templates, variables, validation, and provider-agnostic design.
    </Description>
    <Authors>Johnson Olusegun</Authors>
    <Company>SaaFarr</Company>
    <Copyright>Copyright (c) 2026 Johnson Olusegun</Copyright>
    <PackageProjectUrl>https://github.com/johnsonmima/SaaFarr.AI.Prompt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/johnsonmima/SaaFarr.AI.Prompt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageTags>ai;openai;llm;prompt;prompt-engineering;genai;rag;agents;anthropic;azure-openai;ollama;saafarr</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release with core domain model, templates, fluent builder, validation, serialization, caching, versioning, and provider adapters.</PackageReleaseNotes>
    
    <!-- Source Link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    
    <!-- Version -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyName>SaaFarr.AI.Prompt</AssemblyName>
    <RootNamespace>SaaFarr.AI.Prompt</RootNamespace>
    <!-- GitHub Actions setup-dotnet cache: true hashes these lock files -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Exclude the test project's sources/artifacts from this library's own compilation -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
  </ItemGroup>

  <!-- PolySharp: polyfills modern C# (init, record, Index/Range, etc.) for netstandard2.0 -->
  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- System.Text.Json for older frameworks -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Nullable + HashCode support for netstandard2.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
  </ItemGroup>

  <!-- Allow unit tests to access internal members (e.g. Prompt ctor) -->
  <ItemGroup>
    <InternalsVisibleTo Include="SaaFarr.AI.Prompt.Tests" />
  </ItemGroup>

</Project>
